{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:e2e": "wdio run wdio.conf.js",
    "test:emulator": "wdio run wdio.emulator.conf.js",
    "start": "expo start --clear",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "wdio": "wdio run ./wdio.conf.js"
  },
  "dependencies": {
    "babel-preset-expo": "~55.0.8",
    "expo": "^55.0.17",
    "expo-dev-client": "^55.0.18",
    "expo-linking": "~55.0.8",
    "expo-navigation-bar": "~55.0.9",
    "expo-router": "^55.0.7",
    "expo-splash-screen": "^55.0.19",
    "expo-status-bar": "~55.0.4",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "^4.24.0",
    "react-native-worklets": "^0.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.14",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@wdio/visual-service": "^9.2.2",
    "appium": "^3.3.1",
    "appium-uiautomator2-driver": "^7.1.2",
    "eslint": "10.1.0",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "react-refresh": "^0.18.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "wdio-reportportal-service": "^7.3.1"
  },
  "main": "expo-router/entry",
  "private": true
}
